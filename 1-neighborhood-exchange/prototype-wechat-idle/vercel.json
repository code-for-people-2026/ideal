{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "node scripts/verify-build.mjs",
  "regions": ["sin1"],
  "trailingSlash": false,
  "rewrites": [
    { "source": "/baolong", "destination": "/baolong.html" },
    { "source": "/luanshan", "destination": "/luanshan.html" }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 30, "includeFiles": "dist/assets/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    }
  ]
}
