{
  "name": "baolong-idle-week",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.mjs",
    "db:import": "node --env-file=.env.local scripts/import-snapshot.mjs",
    "db:check": "node scripts/import-snapshot.mjs --check",
    "test": "node --test tests/snapshot.test.mjs tests/auth.test.mjs",
    "test:browser": "node --env-file=.env.local --test tests/loading.test.mjs",
